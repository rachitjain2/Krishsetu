rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Profiles can be read across platform for verified badges, and updated by owners or in demo mode
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // CROP LISTINGS COLLECTION
    // Open marketplace browsing and listing management
    match /cropListings/{listingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ORDERS COLLECTION
    // Realtime marketplace orders tracking and escrow lifecycle
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // MACHINERY COLLECTION
    // Machinery availability catalog & booking dispatch
    match /machinery/{machineId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // RENTAL REQUESTS COLLECTION
    // GPS dispatch, OTP verification and rental status transitions
    match /rentalRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // AI RECOMMENDATIONS COLLECTION
    // Crop advisory records and agronomic diagnosis
    match /aiRecommendations/{recommendationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // LISTINGS COLLECTION (Group Bulk-Bundling)
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // BUNDLES COLLECTION (Group Bulk-Bundling Lots)
    match /bundles/{bundleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}

